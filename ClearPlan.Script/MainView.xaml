<UserControl x:Class="ClearPlan.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lang="clr-namespace:ClearPlan.Presentation.Localization;assembly=ClearPlan.Presentation"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:views="clr-namespace:ClearPlan.Views"
        xmlns:review="clr-namespace:ClearPlan.Presentation.Views;assembly=ClearPlan.Presentation"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ClinicalBlueprint.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MetricNumber" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintText}"/>
            </Style>
            <Style x:Key="SyntheticDemoToggle" TargetType="ToggleButton">
                <Setter Property="Content" Value="Sandbox (Manuskript)"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="Background" Value="#EEF2F6"/>
                <Setter Property="BorderBrush" Value="#B9C5D0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Content" Value="Sandbox aktiv"/>
                        <Setter Property="Background" Value="#FFF2D5"/>
                        <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintAmber}"/>
                        <Setter Property="Foreground" Value="#7A4B00"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource ClinicalBlueprintCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="NativeHeader" Grid.Row="0" Background="{StaticResource ClinicalBlueprintSurface}"
                BorderBrush="{StaticResource ClinicalBlueprintBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{lang:Translate Value='ClearPlan · Clinical Blueprint'}" FontSize="21"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                    <TextBlock x:Name="ClinicalContextText"
                               Text="{Binding ActivePlanningItem.PlanningItemIdWithCourseAndType}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                    <TextBlock x:Name="SyntheticContextText"
                               Text="{lang:Translate Value='SYNTHETIC DEMONSTRATION — NOT FOR CLINICAL USE'}"
                               TextWrapping="Wrap"
                               Foreground="#9A6508"
                               FontWeight="Bold"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="SharedWorkspaceStatusText"
                               FontSize="11" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintTextMuted}"/>
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="Success">
                                        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintTeal}"/>
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Warning">
                                        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintWarningText}"/>
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintRed}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="SwitchPlanButton" Grid.Column="1"
                        Content="{lang:Translate Value='Plan wechseln'}" Click="SwitchPlanClicked"
                        MinHeight="36" Margin="0,0,12,0" Padding="12,8"
                        Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                        ToolTip="{lang:Translate Value='Anderen Plan oder eine Plansumme des geöffneten Patienten prüfen. Keine Änderung in Eclipse.'}"
                        VerticalAlignment="Center"/>
                <ToggleButton x:Name="SyntheticDemoToggle"
                              Grid.Column="2" MinHeight="36"
                              Style="{StaticResource SyntheticDemoToggle}"
                              ToolTip="{lang:Translate Value='Manuskript-Modus: ausschließlich synthetische Pläne, DVHs, CT-Beispiele und BEVs. Fenstertitel, Ansicht und PDF verwenden Dummy-Angaben. Keine Anonymisierung klinischer Bilder; nur dieses Fenster, nicht gespeichert.'}"
                              Click="SyntheticDemoToggle_Click"
                              VerticalAlignment="Center"/>
                <Menu Grid.Column="3" VerticalAlignment="Center"
                      Background="Transparent">
                    <MenuItem x:Name="ClinicalExtrasMenuItem"
                              Header="{lang:Translate Value='Extras'}">
                        <MenuItem Header="{lang:Translate Value='Einstellungen …'}"
                                  Click="SharedSettings_Click"/>
                        <Separator/>
                        <MenuItem Header="{lang:Translate Value='Planübersicht'}"
                                  Click="PlanSummary_Click"/>
                        <MenuItem Header="{lang:Translate Value='Vergleichen'}"
                                  Click="Compare_Click"/>
                        <MenuItem Header="{lang:Translate Value='PQM als CSV speichern'}"
                                  Click="CSV_Button_Click"/>
                        <Separator/>
                        <MenuItem Header="{lang:Translate Value='Bericht anonymisieren'}"
                                  x:Name="Anonymize_CheckBox"
                                  Click="Anonymize_Click"
                                  IsCheckable="True" StaysOpenOnClick="True"/>
                        <MenuItem Header="{lang:Translate Value='PlanCheck in Bericht'}"
                                  IsCheckable="True"
                                  StaysOpenOnClick="True"
                                  IsChecked="{Binding IsChecked, ElementName=PrintPC_CB, Mode=TwoWay}"/>
                        <MenuItem Header="{lang:Translate Value='DRRs erzeugen'}"
                                  IsCheckable="True"
                                  StaysOpenOnClick="True"
                                  IsChecked="{Binding IsChecked, ElementName=DRR_CB, Mode=TwoWay}"/>
                        <MenuItem Header="{lang:Translate Value='eDoc-Dokument erzeugen'}"
                                  IsCheckable="True"
                                  StaysOpenOnClick="True"
                                  IsChecked="{Binding IsChecked, ElementName=eDoc_CB, Mode=TwoWay}"/>
                    </MenuItem>
                    <MenuItem Header="{lang:Translate Value='Hilfe'}">
                        <MenuItem Header="{lang:Translate Value='Änderungsprotokoll'}" Click="ChangeLog_Click"/>
                        <MenuItem Header="{lang:Translate Value='Feedback'}" Click="Feedback_Click"/>
                    </MenuItem>
                </Menu>
                <Grid x:Name="HeaderConstraintRow" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ClinicalConstraintPanel" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ConstraintTableLabel" Text="{lang:Translate Value='Constraint-Tabelle'}" Grid.ColumnSpan="2"
                                   Margin="0,0,0,4" FontSize="11"
                                   Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                        <ComboBox x:Name="SharedConstraintComboBox" Grid.Row="1"
                                  ItemsSource="{Binding ConstraintComboBoxList}"
                                  SelectedItem="{Binding ActiveConstraintPath, Mode=OneWay}"
                                  DisplayMemberPath="ConstraintName"
                                  SelectionChanged="SharedConstraintComboBoxChanged"
                                  ToolTip="{Binding ActiveConstraintPath.ConstraintName}"
                                  MinWidth="260" MinHeight="36" VerticalContentAlignment="Center"/>
                        <Button x:Name="ConfirmConstraintButton" Grid.Row="1" Grid.Column="1"
                                Content="{lang:Translate Value='Prüftabelle bestätigen und auswerten'}"
                                Click="ConfirmConstraintTableClicked" Margin="12,0,0,0" Padding="10,6" MinHeight="36"
                                Style="{StaticResource ClinicalBlueprintSecondaryButton}"/>
                    </Grid>
                    <Border x:Name="ClinicalConstraintStatus" Grid.Column="1" Padding="12,7"
                            Background="#E8EEF8" CornerRadius="5" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding ConstraintSourceStatus}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" Foreground="#1E3A8A"/>
                            <TextBlock Text="{Binding ActiveConstraintPath.ConstraintName}" TextWrapping="Wrap"
                                       Foreground="#475569" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="NewID_TextBlock" Grid.Column="0"
                           Visibility="Collapsed" Text="{lang:Translate Value='Neue ID:'}"/>
                <TextBox x:Name="NewID_TextBox" Grid.Column="0"
                         Visibility="Collapsed" Text="{lang:Translate Value='anonym'}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- The host supplies a detached snapshot on Loaded. Never inherit legacy OxyPlot models. -->
            <review:ReviewWorkspaceView x:Name="SharedReviewWorkspace"
                                        DataContext="{x:Null}"
                                        Visibility="Collapsed"/>
            <Border x:Name="LegacyCompatibilitySurface">
        <TabControl x:Name="MainNavigation"
                    TabStripPlacement="Left" BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Background="{StaticResource ClinicalBlueprintCanvas}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource ClinicalBlueprintNavigation}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="18,14">
                                    <TextBlock Text="{lang:Translate Value='READ ONLY'}" Foreground="#93A7C4"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{lang:Translate Value='ESAPI-Prüfung ohne Planänderung'}"
                                               Foreground="#B9C7D9" FontSize="10"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <TabPanel IsItemsHost="True" Margin="0,14,0,0"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource ClinicalBlueprintCanvas}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Margin="0"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="{lang:Translate Value='Gesamtansicht'}" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{lang:Translate Value='Planübersicht'}" Click="PlanSummary_Click"
                                         Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                         Margin="6,0"/>
                                <Button Content="{lang:Translate Value='Vergleichen'}" Click="Compare_Click"
                                        Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                        Margin="6,0"/>
                                <Button Content="{lang:Translate Value='PDF-Report'}" Click="PrintButtonClicked"
                                        Style="{StaticResource ClinicalBlueprintPrimaryButton}"
                                        Margin="6,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{lang:Translate Value='Gesamtansicht'}"
                                           Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                                <TextBlock Text="{lang:Translate Value='Plan, PQM, PlanCheck, Feldlogik und DVH in einem durchgängigen Review.'}"
                                           Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="{StaticResource ClinicalBlueprintSurface}"
                                BorderBrush="{StaticResource ClinicalBlueprintBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12,9" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveConstraintPath.ConstraintName}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ClinicalBlueprintCobaltDark}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ConstraintSourceStatus}"
                                               Foreground="{StaticResource ClinicalBlueprintTextMuted}"
                                               FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{lang:Translate Value='PQM erfüllt'}" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Overview.PqmPassed}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource ClinicalBlueprintGreen}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{lang:Translate Value='PQM offen'}" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Overview.PqmFailed}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource ClinicalBlueprintRed}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{lang:Translate Value='PlanCheck Fehler'}" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Overview.PlanCheckErrors}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource ClinicalBlueprintRed}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{lang:Translate Value='Felder passend'}" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Overview.FieldNamesConforming}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource ClinicalBlueprintGreen}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{lang:Translate Value='Pläne'}" FontSize="17"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="OverviewPlanGrid" Grid.Row="1"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          ItemsSource="{Binding PlanningItemSummaries}"
                                          MaxHeight="190" MinHeight="108">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{lang:Translate Value='Plan'}" Binding="{Binding PlanName}" Width="2.5*"/>
                                        <DataGridTemplateColumn Header="" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{lang:Translate Value='Öffnen'}" Click="PlanOpen_Button_Click"
                                                            Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                                            Padding="7,3"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{lang:Translate Value='Erstellt'}" Binding="{Binding PlanCreated}" Width="1.5*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Dosis/Fx'}" Binding="{Binding PlanFxDose}"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Gesamtdosis'}" Binding="{Binding PlanTotalDose}"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Fx'}" Binding="{Binding PlanFractions}"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Behandelt'}" Binding="{Binding TreatedSessions}"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Ziel'}" Binding="{Binding PlanTarget}" Width="1.3*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='PQM'}" Binding="{Binding PQMResult}"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='PC'}" Binding="{Binding PCResult}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="{lang:Translate Value='PQM-Details'}"
                                            Click="NavigateToPqmClicked"
                                            Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                            Padding="9,4"/>
                                    <StackPanel>
                                        <TextBlock Text="{lang:Translate Value='Plan Quality Metrics'}" FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{lang:Translate Value='Die aufgelöste Struktur ist dauerhaft sichtbar.'}"
                                                   Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="OverviewPqmGrid" Grid.Row="1"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          ItemsSource="{Binding PqmSummaries}"
                                          MaxHeight="235" MinHeight="120">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{lang:Translate Value='Vorlage'}" Binding="{Binding TemplateId}" Width="1.2*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Zuordnung'}" Binding="{Binding MappedStructureDisplay}" Width="1.7*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Objective'}" Binding="{Binding DVHObjective}" Width="1.1*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Goal'}" Binding="{Binding Goal}"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Erreicht'}" Binding="{Binding Achieved}" Width="1.1*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Status'}" Binding="{Binding Met}"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Met}" Value="Goal">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Met}" Value="Variation">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Met}" Value="Not met">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="{lang:Translate Value='PlanCheck-Details'}"
                                            Click="NavigateToPlanCheckClicked"
                                            Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                            Padding="9,4"/>
                                    <TextBlock Text="{lang:Translate Value='PlanCheck'}" FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <DataGrid x:Name="OverviewPlanCheckGrid" Grid.Row="1"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          ItemsSource="{Binding ErrorGrid}"
                                          MaxHeight="225" MinHeight="115">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{lang:Translate Value='Prüfung'}" Binding="{Binding Description}" Width="6*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Status'}" Binding="{Binding Status}" Width="1.5*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Schweregrad'}" Binding="{Binding Severity}" Width="1.1*"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="1 - Deviation">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="2 - Variation">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="3 - OK">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="{lang:Translate Value='Feldnamen-Details'}"
                                            Click="NavigateToFieldNamesClicked"
                                            Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                            Padding="9,4"/>
                                    <StackPanel>
                                        <TextBlock Text="{lang:Translate Value='Feldlogik'}" FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{lang:Translate Value='Planpräfix für IDs; PlanFieldNamer-Logik für Namen.'}"
                                                   Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="OverviewFieldGrid" Grid.Row="1"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          ItemsSource="{Binding FieldNamePreviews}"
                                          MaxHeight="220" MinHeight="112">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="45"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Aktuelle ID'}" Binding="{Binding CurrentId}" Width="1.1*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Erwartete ID'}" Binding="{Binding ExpectedId}" Width="1.1*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Aktueller Name'}" Binding="{Binding CurrentName}" Width="1.6*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Namensvorschlag'}" Binding="{Binding SuggestedName}" Width="1.8*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='ID-Status'}" Binding="{Binding IdStatus}" Width="0.9*"/>
                                        <DataGridTextColumn Header="{lang:Translate Value='Name-Status'}" Binding="{Binding NameStatus}" Width="1.1*"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WouldChange}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WouldChange}" Value="False">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="350"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="{lang:Translate Value='DVH-Details'}"
                                            Click="NavigateToDvhClicked"
                                            Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                            Padding="9,4"/>
                                    <StackPanel>
                                        <TextBlock Text="{lang:Translate Value='Dosis-Volumen-Histogramm'}" FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{lang:Translate Value='Auswahl und Kurven sind mit der Detailansicht synchron.'}"
                                                   Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="{StaticResource ClinicalBlueprintBorder}"
                                            BorderThickness="1" CornerRadius="4"
                                            Margin="0,0,10,0" Padding="8">
                                        <ListBox ItemsSource="{Binding DvhStructures}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Id}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Margin="3"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <Border Grid.Column="1"
                                            BorderBrush="{StaticResource ClinicalBlueprintBorder}"
                                            BorderThickness="1" CornerRadius="4"
                                            Background="White" Padding="4">
                                        <oxy:PlotView x:Name="OverviewDvhPlot"
                                                      Model="{Binding OverviewPlotModel}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{lang:Translate Value='PQM'}" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid x:Name="PqmDetailPage" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox x:Name="eDoc_CB" Content="{lang:Translate Value='eDoc'}" Margin="8,0"
                                      VerticalAlignment="Center"/>
                            <CheckBox x:Name="DRR_CB" Content="{lang:Translate Value='DRRs'}" Margin="8,0"
                                      VerticalAlignment="Center"/>
                            <Button Content="{lang:Translate Value='CSV speichern'}" Click="CSV_Button_Click"
                                    Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="6,0"/>
                            <Button Content="{lang:Translate Value='PDF drucken'}" Click="PrintButtonClicked"
                                    Style="{StaticResource ClinicalBlueprintPrimaryButton}" Margin="6,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{lang:Translate Value='Plan Quality Metrics'}"
                                       Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="{lang:Translate Value='Constraint-Tabelle:'}" VerticalAlignment="Center"
                                           Foreground="#475569"/>
                                <ComboBox x:Name="ConstraintComboBox" Width="320" Margin="10,0"
                                          ItemsSource="{Binding ConstraintComboBoxList}"
                                          SelectedItem="{Binding ActiveConstraintPath}"
                                          DisplayMemberPath="ConstraintName"
                                          SelectionChanged="ConstraintComboBoxChanged"/>
                                <TextBlock Text="{Binding ConstraintSourceStatus}"
                                           VerticalAlignment="Center" Foreground="#1D4ED8"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="pqmDataGrid" Grid.Row="1"
                              EnableRowVirtualization="False" IsReadOnly="True"
                              AutoGenerateColumns="False" ItemsSource="{Binding PqmSummaries}"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{lang:Translate Value='Template'}" Binding="{Binding TemplateId}" Width="1.6*"/>
                            <DataGridTemplateColumn Header="{lang:Translate Value='Gefundene Struktur'}" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ComboBox x:Name="StructureComboBox"
                                                      ItemsSource="{Binding StructureList}"
                                                      DisplayMemberPath="StructureNameWithCode"
                                                      SelectedItem="{Binding Structure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DropDownClosed="StructureChanged"/>
                                            <TextBlock Text="{Binding MappedStructureDisplay}"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,28,0"
                                                       Background="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{lang:Translate Value='Volumen'}" Binding="{Binding StructVolume}"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Objective'}" Binding="{Binding DVHObjective}" Width="1.3*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Goal'}" Binding="{Binding Goal}"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Variation'}" Binding="{Binding Variation}"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Erreicht'}" Binding="{Binding Achieved}" Width="1.3*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Status'}" Binding="{Binding Met}"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Quelle'}" Binding="{Binding Source}"/>
                            <DataGridTemplateColumn Header="{lang:Translate Value='Akzeptieren'}" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="checkboxinstance" HorizontalAlignment="Center"
                                                  IsChecked="{Binding Accept, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{lang:Translate Value='Ignorieren'}" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="checkboxinstance2" HorizontalAlignment="Center"
                                                  IsChecked="{Binding Ignore, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Met}" Value="Goal">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Met}" Value="Variation">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Met}" Value="Not met">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <Border Grid.Row="2" Background="{StaticResource ClinicalBlueprintSurface}"
                            BorderBrush="{StaticResource ClinicalBlueprintBorder}" BorderThickness="1"
                            CornerRadius="5" Padding="10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="75"/><ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="55"/><ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="55"/><ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{lang:Translate Value='Struktur:'}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AddConstraintComboBox" Grid.Column="1"
                                      ItemsSource="{Binding StructureList}"
                                      DisplayMemberPath="StructureNameWithCode"/>
                            <TextBlock Grid.Column="2" Text="{lang:Translate Value='Objective:'}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DVHObjective1ComboBox" Grid.Column="3" SelectedIndex="0">
                                <ComboBoxItem Content="{lang:Translate Value='Mean[Gy]'}"/><ComboBoxItem Content="{lang:Translate Value='Max[Gy]'}"/>
                                <ComboBoxItem Content="{lang:Translate Value='Min[Gy]'}"/><ComboBoxItem Content="{lang:Translate Value='D_%[%]'}"/>
                                <ComboBoxItem Content="{lang:Translate Value='D_cc[Gy]'}"/><ComboBoxItem Content="{lang:Translate Value='V_Gy[%]'}"/>
                                <ComboBoxItem Content="{lang:Translate Value='CV_Gy[%]'}"/><ComboBoxItem Content="{lang:Translate Value='DC_%[Gy]'}"/>
                            </ComboBox>
                            <TextBox x:Name="DVHObjective2TextBox" Grid.Column="4" Margin="4,0"/>
                            <ComboBox x:Name="Goal1ComboBox" Grid.Column="5" SelectedIndex="0">
                                <ComboBoxItem Content="{lang:Translate Value='&lt;='}"/><ComboBoxItem Content=">="/>
                            </ComboBox>
                            <TextBlock Grid.Column="6" Text="{lang:Translate Value='Goal:'}" VerticalAlignment="Center"/>
                            <TextBox x:Name="Goal2TextBox" Grid.Column="7" Margin="4,0"/>
                            <TextBlock Grid.Column="8" Text="{lang:Translate Value='Variation:'}" VerticalAlignment="Center"/>
                            <TextBox x:Name="VariationTextBox" Grid.Column="9" Margin="4,0"/>
                            <Button Grid.Column="10" Content="{lang:Translate Value='Constraint ergänzen'}"
                                    Click="AddConstraintButtonClicked"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ClinicalBlueprintPrimaryButton}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{lang:Translate Value='PlanCheck'}" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid x:Name="PlanCheckDetailPage" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <CheckBox x:Name="PrintPC_CB" DockPanel.Dock="Right"
                                  Content="{lang:Translate Value='PlanCheck im Bericht'}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{lang:Translate Value='PlanCheck'}"
                                       Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                            <TextBlock Text="{lang:Translate Value='Vollständige klinische Prüflogik des vorhandenen ErrorCalculator.'}"
                                       Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="errorDataGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              ItemsSource="{Binding ErrorGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{lang:Translate Value='Prüfung'}" Binding="{Binding Description}" Width="6*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Status'}" Binding="{Binding Status}" Width="1.6*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Schweregrad'}" Binding="{Binding Severity}" Width="1.2*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="1 - Deviation">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="2 - Variation">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="3 - OK">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{lang:Translate Value='Referenzpunkte'}" FontSize="16"
                               FontWeight="SemiBold" Margin="0,14,0,7"
                               Foreground="#1E3A8A"/>
                    <DataGrid x:Name="refDataGrid" Grid.Row="3"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              ItemsSource="{Binding RefGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{lang:Translate Value='Referenz'}" Binding="{Binding RefPointId}" Width="1.4*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Verordnung'}" Binding="{Binding Prescription}" Width="1.5*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Sitzung'}" Binding="{Binding Session}"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Fx'}" Binding="{Binding Fractions}"/>
                            <DataGridTextColumn Header="{lang:Translate Value='D50'}" Binding="{Binding D50}"/>
                            <DataGridTextColumn Header="{lang:Translate Value='D95'}" Binding="{Binding D95}"/>
                            <DataGridTextColumn Header="{lang:Translate Value='D2'}" Binding="{Binding D2}"/>
                            <DataGridTextColumn Header="{lang:Translate Value='D98'}" Binding="{Binding D98}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{lang:Translate Value='Feldnamen'}" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid x:Name="FieldNamesDetailPage" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{lang:Translate Value='Feldnamen-Vorschau'}"
                                   Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                        <TextBlock Text="{lang:Translate Value='PlanFieldNamer-kompatible Vorschläge in Behandlungsreihenfolge. Diese Seite verändert weder ID noch Name.'}"
                                   Foreground="{StaticResource ClinicalBlueprintTextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FieldNamePreviews}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="55"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Beam #'}" Binding="{Binding BeamNumber}" Width="75"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Aktuelle ID'}" Binding="{Binding CurrentId}" Width="1.2*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Erwartete ID'}" Binding="{Binding ExpectedId}" Width="1.2*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Aktueller Name'}" Binding="{Binding CurrentName}" Width="1.6*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Vorschlag'}" Binding="{Binding SuggestedName}" Width="2*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='ID-Status'}" Binding="{Binding IdStatus}" Width="1.1*"/>
                            <DataGridTextColumn Header="{lang:Translate Value='Name-Status'}" Binding="{Binding NameStatus}" Width="1.2*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WouldChange}" Value="True">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WouldChange}" Value="False">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{lang:Translate Value='DVH'}" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid x:Name="DvhDetailPage" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="{lang:Translate Value='DVH zurücksetzen'}"
                                Click="RefreshDVHClicked"
                                Style="{StaticResource ClinicalBlueprintSecondaryButton}"/>
                        <StackPanel>
                            <TextBlock Text="{lang:Translate Value='Dosis-Volumen-Histogramm'}"
                                       Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                            <TextBlock Text="{lang:Translate Value='Strukturen auswählen und Kurven gemeinsam prüfen.'}"
                                       Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ClinicalBlueprintCard}" Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="DVHstrucListBox" ItemsSource="{Binding DvhStructures}"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox x:Name="DVHstrucCBs" Content="{Binding Id}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="3"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ClinicalBlueprintCard}">
                            <oxy:PlotView Model="{Binding PlotModel}">
                                <oxy:PlotView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{lang:Translate Value='Als PDF exportieren …'}"
                                                  Click="ExportPlotAsPdf"/>
                                    </ContextMenu>
                                </oxy:PlotView.ContextMenu>
                            </oxy:PlotView>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="LegacySettingsTab"
                     Header="{lang:Translate Value='Einstellungen'}"
                     GotFocus="LegacySettingsTab_Selected"
                     Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid x:Name="SettingsDetailPage">
                </Grid>
            </TabItem>
        </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
