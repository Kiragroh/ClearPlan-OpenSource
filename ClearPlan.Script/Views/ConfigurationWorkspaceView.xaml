<UserControl x:Class="ClearPlan.Views.ConfigurationWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lang="clr-namespace:ClearPlan.Presentation.Localization;assembly=ClearPlan.Presentation"
    Background="{DynamicResource ClinicalBlueprintCanvas}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ClearPlan.Presentation;component/Styles/ClinicalBlueprint.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
            <Style x:Key="ConfigurationLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintTextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,10,0,3"/>
            </Style>
            <Style x:Key="ConfigurationPath" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintSurfaceMuted}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintBorder}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="{lang:Translate Value='Konfigurationen &amp; Versionen'}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
            <TextBlock Text="{lang:Translate Value='Datei auswählen, Änderungen prüfen und mit nachvollziehbarem Grund übernehmen. Wiederherstellen legt einen neuen Dateistand an.'}"
                       Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <ListBox x:Name="EntriesList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=OneWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="EntryChanged" BorderBrush="{StaticResource ClinicalBlueprintBorder}"
                     AutomationProperties.Name="{lang:Translate Value='Konfigurationsbereiche'}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintText}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ClinicalBlueprintSurfaceMuted}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E5ECEC"/>
                                        <Setter Property="Foreground" Value="#175D59"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintTeal}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintTeal}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{lang:Translate Path=Title}" TextWrapping="Wrap" FontWeight="SemiBold"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{lang:Translate Value='Versionsablage'}" Style="{StaticResource ConfigurationLabel}" Margin="0,18,0,4"/>
            <TextBox Text="{Binding RootDirectory, Mode=OneWay}" Style="{StaticResource ConfigurationPath}" AutomationProperties.Name="{lang:Translate Value='Versionsablage'}"/>
            <TextBlock Text="{lang:Translate Value='Ablagepfad unter „Pfade &amp; Quellen“ ändern und speichern. Es werden keine bestehenden Quellen automatisch importiert.'}"
                       TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{StaticResource ClinicalBlueprintTextMuted}" FontSize="12"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,4">
                <TextBlock Text="{lang:Translate Path=SelectedEntry.Title}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                <TextBlock Text="{lang:Translate Path=SelectedEntry.Description}" TextWrapping="Wrap" Margin="0,4,0,10" Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                <TextBlock Text="{lang:Translate Path=StateLabel}" FontWeight="SemiBold" Foreground="{StaticResource ClinicalBlueprintText}"/>
                <TextBlock Text="{lang:Translate Value='Konfigurierter Quellpfad (Einstellungsentwurf)'}" Style="{StaticResource ConfigurationLabel}"/>
                <TextBox Text="{Binding ConfiguredPath, Mode=OneWay}" Style="{StaticResource ConfigurationPath}" AutomationProperties.Name="{lang:Translate Value='Konfigurierter Quellpfad'}"/>
                <TextBlock Text="{lang:Translate Value='Geprüfter Versionspfad · Aktivierung erst mit Einstellungen speichern'}" Style="{StaticResource ConfigurationLabel}"/>
                <TextBox Text="{Binding ManagedPath, Mode=OneWay}" Style="{StaticResource ConfigurationPath}" AutomationProperties.Name="{lang:Translate Value='Geprüfter Versionspfad'}"/>
                <TextBlock Text="{lang:Translate Value='Änderungsgrund · für Import, Speichern und Wiederherstellen erforderlich'}" Style="{StaticResource ConfigurationLabel}"/>
                <TextBox Text="{Binding ChangeReason, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MinHeight="34"
                         MaxLength="2048" AutomationProperties.Name="{lang:Translate Value='Änderungsgrund'}"/>
                <WrapPanel Margin="0,10,0,10">
                    <Button Content="{lang:Translate Value='Quelle importieren'}" Click="ImportConfiguredClicked" Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="0,0,7,6"/>
                    <Button Content="{lang:Translate Value='Andere Datei importieren …'}" Click="ImportOtherClicked" Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="0,0,7,6"/>
                    <Button Content="{lang:Translate Value='Neu laden'}" Click="RefreshClicked" Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="0,0,0,6"/>
                </WrapPanel>
                <StackPanel Visibility="{Binding IsJson, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Text="{lang:Translate Value='JSON-Inhalt'}" FontWeight="SemiBold" Margin="0,4,0,7"/>
                    <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditJson}"
                             AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" Height="230"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10"
                             AutomationProperties.Name="{lang:Translate Value='JSON-Konfiguration bearbeiten'}"/>
                    <WrapPanel Margin="0,9,0,8">
                        <Button Content="{lang:Translate Value='Prüfen &amp; als Version speichern'}" Click="SaveJsonClicked" IsEnabled="{Binding CanEditJson}"
                                Style="{StaticResource ClinicalBlueprintPrimaryButton}" Margin="0,0,8,6"/>
                        <Button Content="{lang:Translate Value='Entwurf verwerfen'}" Click="CancelClicked" Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding IsExcel, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Text="{lang:Translate Value='Separater Excel-Entwurf · nicht aktiv'}" Style="{StaticResource ConfigurationLabel}"/>
                    <TextBox Text="{Binding EditingPath, Mode=OneWay}" Style="{StaticResource ConfigurationPath}" AutomationProperties.Name="{lang:Translate Value='Separater Excel-Entwurf'}" Margin="0,0,0,8"/>
                    <TextBlock Text="{lang:Translate Value='Excel wird als separater Entwurf geöffnet. Dort speichern und schließen; erst „Änderung übernehmen“ prüft den Katalog und veröffentlicht einen neuen Dateistand.'}"
                               TextWrapping="Wrap" Margin="0,4,0,9"/>
                    <WrapPanel>
                        <Button Content="{lang:Translate Value='Excel-Entwurf öffnen'}" Click="OpenExcelClicked" IsEnabled="{Binding CanEditExcel}"
                                Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="0,0,8,6"/>
                        <Button Content="{lang:Translate Value='Änderung übernehmen'}" Click="AcceptExcelClicked" IsEnabled="{Binding CanAcceptExcel}"
                                Style="{StaticResource ClinicalBlueprintPrimaryButton}" Margin="0,0,8,6"/>
                        <Button Content="{lang:Translate Value='Entwurf verwerfen'}" Click="CancelClicked" Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
                <Border Background="{StaticResource ClinicalBlueprintInfoSurface}" Padding="10" Margin="0,4,0,14">
                    <TextBlock Text="{lang:Translate Path=StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource ClinicalBlueprintText}"
                               AutomationProperties.Name="{lang:Translate Value='Konfigurationsstatus'}" AutomationProperties.LiveSetting="Polite"/>
                </Border>
                <TextBlock Text="{lang:Translate Value='Versionsverlauf'}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,8" Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Height="185" MinHeight="140"
                          SelectionMode="Single" AutomationProperties.Name="{lang:Translate Value='Versionen der gewählten Konfiguration'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{lang:Translate Value='Version'}" Binding="{Binding RevisionNumber}" Width="65"/>
                        <DataGridTextColumn Header="{lang:Translate Value='Zeit (UTC)'}" Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                        <DataGridTextColumn Header="{lang:Translate Value='Windows-Konto'}" Binding="{Binding Actor}" Width="160"/>
                        <DataGridTextColumn Header="{lang:Translate Value='Grund'}" Binding="{Binding ChangeReason}" Width="220"/>
                        <DataGridTextColumn Header="{lang:Translate Value='Aktion'}" Binding="{Binding Action}" Width="75"/>
                        <DataGridTextColumn Header="{lang:Translate Value='Aus Version'}" Binding="{Binding SourceRevision}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{lang:Translate Value='SHA-256 der ausgewählten Version'}" Style="{StaticResource ConfigurationLabel}"/>
                <TextBox Text="{Binding SelectedVersion.Sha256, Mode=OneWay}" Style="{StaticResource ConfigurationPath}" FontFamily="Consolas" FontSize="11"
                         AutomationProperties.Name="{lang:Translate Value='SHA-256 der ausgewählten Version'}"/>
                <Button Content="{lang:Translate Value='Ausgewählte Version wiederherstellen …'}" Click="RestoreClicked" IsEnabled="{Binding IsManaged}"
                        HorizontalAlignment="Left" Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="0,10,0,10"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ClinicalBlueprintTextMuted}" FontSize="12">
                    <Run Text="{lang:Translate Value='Erfasstes Windows-Konto: '}"/><Run Text="{Binding Actor, Mode=OneWay}"/>
                    <Run Text="{lang:Translate Value='. Kontoname und Hash dienen der Nachvollziehbarkeit, nicht einer kryptografisch authentifizierten Signatur oder klinischen Freigabe. Gemeinsame Ablagen benötigen passende Windows-Zugriffsrechte.'}"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
