<UserControl x:Class="ClearPlan.Presentation.Views.PlanParametersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lang="clr-namespace:ClearPlan.Presentation.Localization"
 xmlns:oxy="http://oxyplot.org/wpf" FontFamily="Segoe UI" FontWeight="Normal" Foreground="{DynamicResource ClinicalBlueprintText}">
 <!-- THESIS: Inspect delivery complexity alongside its evidence, not a pass/fail score.
 OWN-WORLD: Existing slate navigation, paper-white plotting surfaces, teal traces, quiet hairlines.
 STORY: Read plan totals, select a beam, inspect the control-point trace and metric definitions.
 FIRST VIEWPORT: Plan summary strip; wide paired traces; field selector above and full-width beam table below.
 FORM: Scoped extension of the established native WPF workspace; no concept seed required.
 FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/ClinicalBlueprint.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer x:Name="ParameterScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
  <StackPanel Margin="24,22">
   <DockPanel>
    <Button Content="{lang:Translate Value='ESAPI-Geometrie aktualisieren'}" Command="{Binding ImportPlanDataCommand}" DockPanel.Dock="Right" Style="{StaticResource ClinicalBlueprintSecondaryButton}" ToolTip="{lang:Translate Value='Native ESAPI-Kontrollpunkte lesen und mit dem Maschinenprofil aus settings.ini zuordnen. Kein DICOM-Export; keine TPS-Änderungen.'}" ToolTipService.ShowOnDisabled="True"/>
    <Button x:Name="ShowParameterPlotsButton" Content="{lang:Translate Value='Dosisrate &amp; Apertur'}" Click="ShowParameterPlots" DockPanel.Dock="Right" Margin="0,0,10,0" Style="{StaticResource ClinicalBlueprintSecondaryButton}" ToolTip="{lang:Translate Value='Zum Kontrollpunktverlauf des ausgewählten Feldes springen.'}"/>
    <TextBlock Text="{lang:Translate Value='Planparameter'}" Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
   </DockPanel>
   <TextBlock Text="{lang:Translate Value='Modulation verstehen · Abgabeparameter prüfen · Werte nachvollziehen'}" Foreground="{StaticResource ClinicalBlueprintTextMuted}" Margin="0,5,0,20"/>
   <TextBlock Text="{lang:Translate Value='PTV-Qualität · Konformität, Gradient &amp; Homogenität'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <TextBlock Text="{lang:Translate Value='Bezug: Planverschreibung, nicht automatisch die PTV-spezifische Dosis. GI umfasst das gesamte EXTERNAL.'}"
              TextWrapping="Wrap" Foreground="{StaticResource ClinicalBlueprintTextMuted}" Margin="0,0,0,10"/>
   <DataGrid x:Name="TargetQualityTable" ItemsSource="{Binding TargetQuality}" AutoGenerateColumns="False" IsReadOnly="True"
             CanUserAddRows="False" MinHeight="72" MaxHeight="210" AutomationProperties.Name="{lang:Translate Value='PTV-Qualitätsmetriken, nur lesend'}">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{lang:Translate Value='PTV'}" Binding="{Binding StructureId}" Width="*" MinWidth="130"/>
     <DataGridTextColumn Header="{lang:Translate Value='Plan-Rx [Gy]'}" Binding="{Binding ReferenceDoseGy, StringFormat={}{0:0.##}, TargetNullValue=—}" Width="100"/>
     <DataGridTextColumn Header="{lang:Translate Value='Paddick CI'}" Binding="{Binding PaddickCi, StringFormat={}{0:0.000}, TargetNullValue=—}" Width="95"/>
     <DataGridTextColumn Header="{lang:Translate Value='1 / Paddick CI'}" Binding="{Binding PlanCheckCi, StringFormat={}{0:0.000}, TargetNullValue=—}" Width="115"/>
     <DataGridTextColumn Header="{lang:Translate Value='GI · V50/V100'}" Binding="{Binding GradientIndex, StringFormat={}{0:0.000}, TargetNullValue=—}" Width="105"/>
     <DataGridTextColumn Header="{lang:Translate Value='HI · (D2−D98)/Rx'}" Binding="{Binding HomogeneityIndex, StringFormat={}{0:0.000}, TargetNullValue=—}" Width="125"/>
     <DataGridTextColumn Header="{lang:Translate Value='Verfügbarkeit'}" Binding="{Binding AvailabilityScope}" Width="*" MinWidth="110"/>
    </DataGrid.Columns>
   </DataGrid>
   <Expander Header="{lang:Translate Value='Definitionen und Bezugsvolumen'}" Margin="0,8,0,20">
    <TextBlock Text="{Binding TargetQualityNote}" TextWrapping="Wrap" Foreground="{StaticResource ClinicalBlueprintTextMuted}" Margin="0,8,0,0"/>
   </Expander>
   <Border Background="White" BorderBrush="{StaticResource ClinicalBlueprintBorder}" BorderThickness="0,1" Padding="18,14" Margin="0,0,0,20">
    <UniformGrid Columns="4">
     <StackPanel><TextBlock Text="{lang:Translate Value='Gesamt-MU'}" Foreground="{StaticResource ClinicalBlueprintTextMuted}"/><TextBlock Text="{lang:Translate Path=TotalMuText}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
     <StackPanel><TextBlock Text="{lang:Translate Value='Pro Fraktionsdosis'}" Foreground="{StaticResource ClinicalBlueprintTextMuted}"/><TextBlock Text="{lang:Translate Path=MuPerGyText}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
     <StackPanel><TextBlock Text="{lang:Translate Value='PAM · dimensionslos'}" Foreground="{StaticResource ClinicalBlueprintTextMuted}"/><TextBlock Text="{lang:Translate Path=PamText}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
     <StackPanel><TextBlock Text="{lang:Translate Value='Mittlere Apertur'}" Foreground="{StaticResource ClinicalBlueprintTextMuted}"/><TextBlock Text="{lang:Translate Path=AreaText}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    </UniformGrid>
   </Border>
   <DockPanel x:Name="ParameterPlotsHeading" Margin="0,0,0,12">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{lang:Translate Value='Feld'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <ComboBox ItemsSource="{Binding Beams}" SelectedItem="{Binding SelectedBeam}" DisplayMemberPath="BeamId" MinWidth="140" Padding="8,5" AutomationProperties.Name="{lang:Translate Value='Feld für Kontrollpunktverlauf'}"/>
    </StackPanel>
    <StackPanel><TextBlock Text="{lang:Translate Value='Verlauf über die Kontrollpunkte'}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{lang:Translate Path=BeamText}" Foreground="{StaticResource ClinicalBlueprintTextMuted}" Margin="0,4,14,0" TextWrapping="Wrap"/></StackPanel>
   </DockPanel>
   <Grid x:Name="ParameterPlots" Height="330">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="White" Padding="10">
      <StackPanel>
       <TextBlock x:Name="NominalDoseRateValue" Text="{lang:Translate Path=NominalDoseRateText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{lang:Translate Path=DoseRateSummary}" Foreground="{StaticResource ClinicalBlueprintTextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" ToolTip="{lang:Translate Path=DoseRateText}"/>
      </StackPanel>
    </Border>
    <Border Grid.Column="2" Background="White" Padding="10">
     <StackPanel>
      <TextBlock Text="{lang:Translate Value='Aperturfläche'}" FontWeight="SemiBold"/>
      <TextBlock Text="{lang:Translate Value='Geometrie der gespeicherten Kontrollpunkte'}" Foreground="{StaticResource ClinicalBlueprintTextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
    <Grid Grid.Row="1" Background="White" Margin="0,0,0,10">
     <oxy:PlotView x:Name="DoseRatePlot" Model="{Binding DoseRatePlotModel}" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <oxy:PlotView.Style><Style TargetType="oxy:PlotView"><Style.Triggers>
       <DataTrigger Binding="{Binding HasDoseRateTrace}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></oxy:PlotView.Style>
     </oxy:PlotView>
     <Border x:Name="DoseRateUnavailable" Padding="24" VerticalAlignment="Stretch" ToolTip="{lang:Translate Path=DoseRateText}">
      <Border.Style><Style TargetType="Border"><Style.Triggers>
       <DataTrigger Binding="{Binding HasDoseRateTrace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></Border.Style>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{lang:Translate Value='Dosisratenverlauf nicht verfügbar'}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{lang:Translate Value='Kein gültiges Schätzprofil oder keine vollständigen Eingangsdaten. Der Feld-Sollwert ist kein Verlauf.'}" Foreground="{StaticResource ClinicalBlueprintTextMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
    <Border Grid.Row="1" Grid.Column="2" Background="White" Padding="10,0,10,10"><oxy:PlotView x:Name="AperturePlot" Model="{Binding AperturePlotModel}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
   </Grid>
   <TextBlock Text="{lang:Translate Path=DoseRateProfileText}" ToolTip="{lang:Translate Path=DoseRateText}" Focusable="True" Foreground="{StaticResource ClinicalBlueprintTextMuted}" TextWrapping="Wrap" Margin="0,8,0,22"/>
   <TextBlock Text="{lang:Translate Value='Behandlungsfelder'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <DataGrid ItemsSource="{Binding Beams}" SelectedItem="{Binding SelectedBeam}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="85" MaxHeight="240">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{lang:Translate Value='Feld'}" Binding="{Binding BeamId}" Width="*"/>
     <DataGridTextColumn Header="{lang:Translate Value='Gerät'}" Binding="{Binding MachineId}" Width="*"/>
     <DataGridTextColumn Header="{lang:Translate Value='MLC'}" Binding="{Binding MlcModel}" Width="1.2*"/>
     <DataGridTextColumn Header="{lang:Translate Value='Lagen'}" Binding="{Binding MlcLayerCount}" Width="65"/>
     <DataGridTextColumn Header="{lang:Translate Value='MU'}" Binding="{Binding MetersetMu, StringFormat={}{0:0.0}, TargetNullValue=—}" Width="80"/>
     <DataGridTextColumn Header="{lang:Translate Value='Nominal [MU/min]'}" Binding="{Binding NominalDoseRateMuPerMin, TargetNullValue=—}" Width="125"/>
     <DataGridTextColumn Header="{lang:Translate Value='BAM'}" Binding="{Binding Pam, StringFormat={}{0:0.000}, TargetNullValue=—}" Width="70"/>
     <DataGridTextColumn Header="{lang:Translate Value='Fläche [cm²]'}" Binding="{Binding MeanApertureAreaCm2, StringFormat={}{0:0.00}, TargetNullValue=—}" Width="100"/>
     <DataGridTextColumn Header="{lang:Translate Value='Geometrie'}" Binding="{Binding GeometryReason}" Width="2*"/>
    </DataGrid.Columns>
   </DataGrid>
   <Grid Margin="0,24,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="{lang:Translate Value='Metriken &amp; Definitionen'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <DataGrid ItemsSource="{Binding Metrics}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
      <DataGridTextColumn Header="{lang:Translate Value='Metrik'}" Binding="{Binding Name}" Width="1.5*"/><DataGridTextColumn Header="{lang:Translate Value='Wert'}" Binding="{Binding ValueText}" Width="80"/><DataGridTextColumn Header="{lang:Translate Value='Einheit'}" Binding="{Binding Unit}" Width="65"/>
      <DataGridTextColumn Header="{lang:Translate Value='Definition'}" Binding="{Binding Note}" Width="2*"/>
     </DataGrid.Columns></DataGrid>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="{lang:Translate Value='PAM-Zielstruktur'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <DockPanel Margin="0,0,0,10"><Button Content="{lang:Translate Value='Berechnen'}" DockPanel.Dock="Right" Command="{Binding CalculateTargetCommand}" Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding AvailableTargets}" SelectedItem="{Binding SelectedTargetStructureId}" Padding="7,4" AutomationProperties.Name="{lang:Translate Value='Zielstruktur für PAM'}"/></DockPanel>
     <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="{lang:Translate Path=MethodText}" TextWrapping="Wrap" Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
     <TextBlock Text="{lang:Translate Path=WarningText}" TextWrapping="Wrap" Foreground="#835509" Margin="0,12,0,0"/>
    </StackPanel>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>
