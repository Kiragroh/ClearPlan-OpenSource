<UserControl x:Class="ClearPlan.Presentation.Views.ReviewWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:views="clr-namespace:ClearPlan.Presentation.Views"
             FontFamily="Segoe UI"
             FontWeight="Normal"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             MinWidth="960"
             MinHeight="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ClinicalBlueprint.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="WorkspaceDvhLegend">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,5" HorizontalContentAlignment="Stretch" ToolTip="Sichtbarkeit in DVH und Schnittbildern umschalten">
                    <StackPanel Orientation="Horizontal"><Border Width="17" Height="3" Background="{Binding ColorHex}" Margin="3,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" MaxWidth="165" Foreground="{StaticResource ClinicalBlueprintText}"/></StackPanel>
                </CheckBox>
            </DataTemplate>
            <DataTemplate x:Key="WorkspaceStatusCellTemplate">
                <Border Style="{StaticResource ClinicalBlueprintStatusBadge}"><TextBlock Text="{Binding StatusText}" Style="{DynamicResource WorkspaceStatusText}"/></Border>
            </DataTemplate>
            <ControlTemplate x:Key="WorkspaceDvhTrackerTemplate">
                <oxy:TrackerControl Position="{Binding Position}"
                                    LineExtents="{Binding PlotModel.PlotArea}"
                                    Background="{StaticResource ClinicalBlueprintSurface}"
                                    Foreground="{StaticResource ClinicalBlueprintText}"
                                    BorderBrush="{StaticResource ClinicalBlueprintBorder}"
                                    BorderThickness="1" Padding="10,7"
                                    CornerRadius="4"
                                    LineStroke="{StaticResource ClinicalBlueprintTextMuted}">
                    <TextBlock Text="{Binding Text}"
                               Foreground="{StaticResource ClinicalBlueprintText}"
                               FontFamily="Segoe UI" FontSize="12"
                               FontWeight="Normal" TextWrapping="Wrap"
                               MaxWidth="320"/>
                </oxy:TrackerControl>
            </ControlTemplate>

            <Style x:Key="WorkspaceBodyText" TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="{StaticResource ClinicalBlueprintText}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="WorkspaceMutedText"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource WorkspaceBodyText}">
                <Setter Property="Foreground"
                        Value="{StaticResource ClinicalBlueprintTextMuted}"/>
            </Style>

            <Style x:Key="WorkspaceStatusText"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource WorkspaceBodyText}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusCode}" Value="pass">
                        <Setter Property="Foreground"
                                Value="{StaticResource ClinicalBlueprintGreen}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusCode}" Value="available">
                        <Setter Property="Foreground"
                                Value="{StaticResource ClinicalBlueprintGreen}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusCode}" Value="variation">
                        <Setter Property="Foreground" Value="#9A6508"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusCode}" Value="fallback">
                        <Setter Property="Foreground" Value="#9A6508"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusCode}" Value="fail">
                        <Setter Property="Foreground"
                                Value="{StaticResource ClinicalBlueprintRed}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusCode}" Value="unavailable">
                        <Setter Property="Foreground"
                                Value="{StaticResource ClinicalBlueprintRed}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WorkspaceSeverityBadge"
                   TargetType="Border"
                   BasedOn="{StaticResource ClinicalBlueprintStatusBadge}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SeverityCode}" Value="none">
                        <Setter Property="Background"
                                Value="{StaticResource ClinicalBlueprintPassSurface}"/>
                        <Setter Property="BorderBrush" Value="#78B88B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeverityCode}" Value="info">
                        <Setter Property="Background"
                                Value="{StaticResource ClinicalBlueprintInfoSurface}"/>
                        <Setter Property="BorderBrush" Value="#8EAFBF"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeverityCode}" Value="warning">
                        <Setter Property="Background"
                                Value="{StaticResource ClinicalBlueprintVariationSurface}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource ClinicalBlueprintAmber}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeverityCode}" Value="error">
                        <Setter Property="Background"
                                Value="{StaticResource ClinicalBlueprintFailSurface}"/>
                        <Setter Property="BorderBrush" Value="#D47C75"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WorkspaceFieldIdBadge" TargetType="Border">
                <Setter Property="Background"
                        Value="{StaticResource ClinicalBlueprintFailSurface}"/>
                <Setter Property="BorderBrush" Value="#D47C75"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IdStatusCode}" Value="pass">
                        <Setter Property="Background"
                                Value="{StaticResource ClinicalBlueprintPassSurface}"/>
                        <Setter Property="BorderBrush" Value="#78B88B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IdStatusCode}" Value="variation">
                        <Setter Property="Background"
                                Value="{StaticResource ClinicalBlueprintVariationSurface}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource ClinicalBlueprintAmber}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WorkspaceFieldNameBadge" TargetType="Border">
                <Setter Property="Background"
                        Value="{StaticResource ClinicalBlueprintFailSurface}"/>
                <Setter Property="BorderBrush" Value="#D47C75"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding NameStatusCode}" Value="pass">
                        <Setter Property="Background"
                                Value="{StaticResource ClinicalBlueprintPassSurface}"/>
                        <Setter Property="BorderBrush" Value="#78B88B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding NameStatusCode}" Value="variation">
                        <Setter Property="Background"
                                Value="{StaticResource ClinicalBlueprintVariationSurface}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource ClinicalBlueprintAmber}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource ClinicalBlueprintCanvas}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ClinicalBlueprintSurface}"
                BorderBrush="{StaticResource ClinicalBlueprintBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScenarioTitle}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ScenarioTitle}"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                    <TextBlock Text="{Binding ScenarioDescription}"
                               Foreground="{StaticResource ClinicalBlueprintTextMuted}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource ClinicalBlueprintModeBadge}"
                        Margin="16,0"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding ModeBadgeText}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                        <TextBlock Text="{Binding ModeBadgeDescription}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ClinicalBlueprintTextMuted}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
                <Button x:Name="HtmlReportButton"
                        Content="HTML-Quicklook"
                        Command="{Binding HtmlReportCommand}"
                        ToolTip="Aktuellen Stand als HTML ansehen. Optionale Feldstart-DRRs werden bei Bedarf ergänzt."
                        Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button x:Name="ReportButton"
                        Content="PDF-Report"
                        Command="{Binding ReportCommand}"
                        Style="{StaticResource ClinicalBlueprintPrimaryButton}"
                        VerticalAlignment="Center"/>
                <Button x:Name="AriaUploadButton" Content="{Binding AriaUploadText}"
                        Command="{Binding AriaUploadCommand}" ToolTip="{Binding AriaUploadStatus}"
                        ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Aktuellen Planreport an ARIA senden"
                        Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox Content="BEV / DRR am Feldstart im Report" IsChecked="{Binding IncludeBeamEyeViews, Mode=TwoWay}" Margin="0,5,0,0" FontSize="11"
                          ToolTip="Bei Bedarf werden Projektionen der ersten Kontrollpunkte einmalig erfasst; ohne Häkchen werden keine BEV-Seiten erzeugt."/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="WorkspaceNavigation"
                    Grid.Row="1"
                    TabStripPlacement="Left"
                    BorderThickness="0"
                    Background="{StaticResource ClinicalBlueprintCanvas}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    SelectionChanged="OnNavigationSelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="196"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource ClinicalBlueprintNavigation}">
                            <DockPanel>
                                <StackPanel x:Name="NavigationFooter"
                                            DockPanel.Dock="Bottom"
                                            Margin="18,14">
                                    <Border Height="2"
                                            Margin="0,0,0,10"
                                            Background="{StaticResource ClinicalBlueprintTeal}"/>
                                    <TextBlock Text="{Binding ModeBadgeDescription}"
                                               Foreground="#B8C5D1"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="NavigationSourceStatusText"
                                               Text="{Binding SourceStatusSummary}"
                                               Foreground="#899AA9"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <TabPanel IsItemsHost="True"
                                          Margin="0,14,0,0"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Background="{StaticResource ClinicalBlueprintCanvas}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem x:Name="OverviewTab"
                     Header="Gesamtansicht"
                     Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <ScrollViewer x:Name="OverallReviewView"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch">
                    <StackPanel Margin="24"
                                HorizontalAlignment="Stretch">
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PatientDisplayLabel}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ClinicalBlueprintText}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding PlanDisplayLabel}"
                                           Style="{StaticResource WorkspaceMutedText}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Gesamtansicht"
                                           Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                                <TextBlock Text="Plan, PQM, PlanCheck, Feldlogik, Zuordnung und DVH in einer Lesereihenfolge."
                                           Style="{StaticResource WorkspaceMutedText}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Datenquellen"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                                <TextBlock Text="{Binding ProvenanceText}"
                                           Style="{StaticResource WorkspaceMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,9"/>
                                <DataGrid x:Name="OverviewSourceGrid"
                                          ItemsSource="{Binding Sources}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MaxHeight="210">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Quelle"
                                                            Binding="{Binding SourceCode}"
                                                            Width="1.1*"/>
                                        <DataGridTextColumn Header="Typ"
                                                            Binding="{Binding SourceType}"
                                                            Width="0.9*"/>
                                        <DataGridTextColumn Header="Pfad / Quelle"
                                                            Binding="{Binding PathDisplayLabel}"
                                                            Width="1.4*"/>
                                        <DataGridTemplateColumn Header="Status"
                                                                Width="0.9*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ClinicalBlueprintStatusBadge}">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource WorkspaceStatusText}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Meldung"
                                                            Binding="{Binding Message}"
                                                            Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Pläne"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ClinicalBlueprintCobaltDark}"
                                           Margin="0,0,0,8"/>
                                <DataGrid x:Name="OverviewPlanGrid"
                                          ItemsSource="{Binding Plans}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Plan"
                                                            Binding="{Binding DisplayLabel}"
                                                            Width="1.6*"/>
                                        <DataGridTemplateColumn Header=""
                                                                Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Öffnen"
                                                            Command="{Binding DataContext.OpenPlanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                                            Padding="9,3"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Erstellt"
                                                            Binding="{Binding CreatedText}"
                                                            Width="1.1*"/>
                                        <DataGridTextColumn Header="Dosis/Fx"
                                                            Binding="{Binding DosePerFractionText}"
                                                            Width="0.8*"/>
                                        <DataGridTextColumn Header="Gesamtdosis"
                                                            Binding="{Binding TotalDoseText}"
                                                            Width="0.8*"/>
                                        <DataGridTextColumn Header="Fx"
                                                            Binding="{Binding FractionCountText}"
                                                            Width="0.5*"/>
                                        <DataGridTextColumn Header="Ziel"
                                                            Binding="{Binding TargetDisplayLabel}"
                                                            Width="1.1*"/>
                                        <DataGridTemplateColumn Header="Status"
                                                                Width="0.9*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ClinicalBlueprintStatusBadge}">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource WorkspaceStatusText}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding PqmSummary}"
                                               Style="{StaticResource WorkspaceMutedText}"/>
                                    <TextBlock Text="Plan Quality Metrics (PQM)"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                                </DockPanel>
                                <DataGrid x:Name="OverviewPqmGrid"
                                          ItemsSource="{Binding VisiblePqmRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MaxHeight="300">
                                    <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Struktur" Width="1.5*" MinWidth="170">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <StackPanel Margin="2,3" ToolTip="{Binding DetailsText}">
                                                <TextBlock Text="{Binding TemplateStructure}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding StructureText}" Foreground="{StaticResource ClinicalBlueprintTextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Kriterium" Binding="{Binding Objective}" Width="80"/>
                                    <DataGridTextColumn Header="Ziel" Binding="{Binding GoalText}" Width="95"/>
                                    <DataGridTextColumn Header="Variation" Binding="{Binding VariationText}" Width="90"/>
                                    <DataGridTextColumn Header="Erreicht" Binding="{Binding AchievedText}" Width="90"/>
                                    <DataGridTemplateColumn Header="Status" Width="120" CellTemplate="{StaticResource WorkspaceStatusCellTemplate}"/>
                                    <DataGridTextColumn Header="Quelle" Binding="{Binding SourceLabel}" Width="1*" MinWidth="115">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding DetailsText}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding PlanCheckSummary}"
                                               Style="{StaticResource WorkspaceMutedText}"/>
                                    <TextBlock Text="PlanCheck"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                                </DockPanel>
                                <DataGrid x:Name="OverviewPlanCheckGrid"
                                          ItemsSource="{Binding PlanCheckRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MaxHeight="300">
                                    <DataGrid.Columns>
                                <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*" MinWidth="300">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding DetailsText}"/><Setter Property="Margin" Value="3,5"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Status" Width="120" CellTemplate="{StaticResource WorkspaceStatusCellTemplate}"/>
                                <DataGridTextColumn Header="Schweregrad" Binding="{Binding SeverityText}" Width="95"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding CheckCode}" Width="65"/>
                                <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="100"/>
                            </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding FieldSummary}"
                                               Style="{StaticResource WorkspaceMutedText}"/>
                                    <TextBlock Text="Feld-ID und Feldname"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                                </DockPanel>
                                <DataGrid x:Name="OverviewFieldGrid"
                                          ItemsSource="{Binding FieldRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MaxHeight="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"
                                                            Binding="{Binding TreatmentOrder}"
                                                            Width="0.4*"/>
                                        <DataGridTextColumn Header="Beam #"
                                                            Binding="{Binding BeamNumber}"
                                                            Width="0.55*"/>
                                        <DataGridTextColumn Header="Aktuelle ID"
                                                            Binding="{Binding CurrentId}"
                                                            Width="1*"/>
                                        <DataGridTextColumn Header="Erwartete ID"
                                                            Binding="{Binding ExpectedId}"
                                                            Width="1*"/>
                                        <DataGridTemplateColumn Header="ID-Status"
                                                                Width="0.9*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource WorkspaceFieldIdBadge}">
                                                        <TextBlock Text="{Binding IdStatusText}"
                                                                   Style="{StaticResource WorkspaceBodyText}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Aktueller Name"
                                                            Binding="{Binding CurrentName}"
                                                            Width="1.5*"/>
                                        <DataGridTextColumn Header="Vorschlag"
                                                            Binding="{Binding SuggestedName}"
                                                            Width="1.5*"/>
                                        <DataGridTemplateColumn Header="Name-Status"
                                                                Width="0.95*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource WorkspaceFieldNameBadge}">
                                                        <TextBlock Text="{Binding NameStatusText}"
                                                                   Style="{StaticResource WorkspaceBodyText}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Strukturzuordnung"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ClinicalBlueprintCobaltDark}"
                                           Margin="0,0,0,8"/>
                                <DataGrid x:Name="OverviewStructureMappingGrid"
                                          ItemsSource="{Binding VisibleStructureMappings}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Template"
                                                            Binding="{Binding TemplateStructure}"
                                                            Width="1*"/>
                                        <DataGridTextColumn Header="Zugeordnet"
                                                            Binding="{Binding SelectedStructureId}"
                                                            Width="1*"/>
                                        <DataGridTemplateColumn Header="Status"
                                                                Width="0.9*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ClinicalBlueprintStatusBadge}">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource WorkspaceStatusText}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Hinweis"
                                                            Binding="{Binding Message}"
                                                            Width="2.4*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="380"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal">
                                        <Button Content="DVH zurücksetzen"
                                                Command="{Binding ResetDvhCommand}"
                                                Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                                Margin="5,0"/>
                                        <Button Content="DVH exportieren"
                                                Command="{Binding ExportDvhCommand}"
                                                Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                                Margin="5,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Dosis-Volumen-Histogramm"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                                </DockPanel>
                                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                <oxy:PlotView x:Name="OverviewDvhPlot"
                                              Model="{Binding OverviewPlotModel}"
                                              Controller="{Binding OverviewPlotController}"
                                              DefaultTrackerTemplate="{StaticResource WorkspaceDvhTrackerTemplate}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
                                    <ItemsControl ItemsSource="{Binding DvhSeries}" ItemTemplate="{StaticResource WorkspaceDvhLegend}"/>
                                </ScrollViewer></Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="PqmTab"
                     Header="PQM"
                     Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid Margin="24"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Plan Quality Metrics"
                                   Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                        <TextBlock Text="Template, feste Strukturzuordnung und dosimetrische Bewertung bleiben gemeinsam sichtbar."
                                   Style="{StaticResource WorkspaceMutedText}"/>
                    <CheckBox Content="Nicht zugeordnete Kriterien ausblenden (GUI + Report)" IsChecked="{Binding HideUnmatched, Mode=TwoWay}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding PqmVisibilityText}" Style="{StaticResource WorkspaceMutedText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1"
                            Style="{StaticResource ClinicalBlueprintCard}">
                        <DataGrid x:Name="PqmDetailGrid"
                                  ItemsSource="{Binding VisiblePqmRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Struktur" Width="1.5*" MinWidth="170">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <StackPanel Margin="2,3" ToolTip="{Binding DetailsText}">
                                                <TextBlock Text="{Binding TemplateStructure}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding StructureText}" Foreground="{StaticResource ClinicalBlueprintTextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Kriterium" Binding="{Binding Objective}" Width="80"/>
                                    <DataGridTextColumn Header="Ziel" Binding="{Binding GoalText}" Width="95"/>
                                    <DataGridTextColumn Header="Variation" Binding="{Binding VariationText}" Width="90"/>
                                    <DataGridTextColumn Header="Erreicht" Binding="{Binding AchievedText}" Width="90"/>
                                    <DataGridTemplateColumn Header="Status" Width="120" CellTemplate="{StaticResource WorkspaceStatusCellTemplate}"/>
                                    <DataGridTextColumn Header="Quelle" Binding="{Binding SourceLabel}" Width="1*" MinWidth="115">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding DetailsText}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="3"
                            Style="{StaticResource ClinicalBlueprintCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Strukturzuordnung"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ClinicalBlueprintCobaltDark}"
                                       Margin="0,0,0,8"/>
                            <DataGrid x:Name="StructureMappingDetailGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding StructureMappings}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Template"
                                                        Binding="{Binding TemplateStructure}"
                                                        IsReadOnly="True"
                                                        Width="1*"/>
                                    <DataGridTemplateColumn Header="Zugeordnete Struktur"
                                                            Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding AvailableStructureIds}"
                                                          SelectedItem="{Binding SelectedStructureId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="150"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header=""
                                                            Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Übernehmen"
                                                        Command="{Binding DataContext.ApplyStructureMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                                        Padding="9,3"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Status"
                                                            IsReadOnly="True"
                                                            Width="0.9*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ClinicalBlueprintStatusBadge}">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Style="{StaticResource WorkspaceStatusText}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Hinweis"
                                                        Binding="{Binding Message}"
                                                        IsReadOnly="True"
                                                        Width="2.1*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PlanCheckTab"
                     Header="PlanCheck"
                     Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid Margin="24"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="PlanCheck"
                                   Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                        <TextBlock Text="Meldung und Ergebnis · technische Werte im Tooltip · Prüfumfang unter Einstellungen"
                                   Style="{StaticResource WorkspaceMutedText}"/>
                    </StackPanel>
                    <Border Grid.Row="1"
                            Style="{StaticResource ClinicalBlueprintCard}">
                        <DataGrid x:Name="PlanCheckDetailGrid"
                                  ItemsSource="{Binding PlanCheckRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*" MinWidth="300">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding DetailsText}"/><Setter Property="Margin" Value="3,5"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Status" Width="120" CellTemplate="{StaticResource WorkspaceStatusCellTemplate}"/>
                                <DataGridTextColumn Header="Schweregrad" Binding="{Binding SeverityText}" Width="95"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding CheckCode}" Width="65"/>
                                <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="FieldsTab"
                     Header="Feldnamen"
                     Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid Margin="24"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Feld-ID und Feldnamen"
                                   Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                        <TextBlock Text="ID-Konformität und Namenslogik werden unabhängig bewertet; die Ansicht verändert weder ID noch Name."
                                   Style="{StaticResource WorkspaceMutedText}"/>
                    </StackPanel>
                    <Border Grid.Row="1"
                            Style="{StaticResource ClinicalBlueprintCard}">
                        <DataGrid x:Name="FieldDetailGrid"
                                  ItemsSource="{Binding FieldRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding TreatmentOrder}"
                                                    Width="0.4*"/>
                                <DataGridTextColumn Header="Beam #"
                                                    Binding="{Binding BeamNumber}"
                                                    Width="0.55*"/>
                                <DataGridTextColumn Header="Aktuelle ID"
                                                    Binding="{Binding CurrentId}"
                                                    Width="1*"/>
                                <DataGridTextColumn Header="Erwartete ID"
                                                    Binding="{Binding ExpectedId}"
                                                    Width="1*"/>
                                <DataGridTemplateColumn Header="ID-Status"
                                                        Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource WorkspaceFieldIdBadge}">
                                                <TextBlock Text="{Binding IdStatusText}"
                                                           Style="{StaticResource WorkspaceBodyText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Aktueller Name"
                                                    Binding="{Binding CurrentName}"
                                                    Width="1.5*"/>
                                <DataGridTextColumn Header="Vorschlag"
                                                    Binding="{Binding SuggestedName}"
                                                    Width="1.5*"/>
                                <DataGridTemplateColumn Header="Name-Status"
                                                        Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource WorkspaceFieldNameBadge}">
                                                <TextBlock Text="{Binding NameStatusText}"
                                                           Style="{StaticResource WorkspaceBodyText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="DvhTab"
                     Header="DVH"
                     Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid Margin="16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button Content="DVH zurücksetzen"
                                    Command="{Binding ResetDvhCommand}"
                                    Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                    Margin="5,0"/>
                            <Button Content="DVH exportieren"
                                    Command="{Binding ExportDvhCommand}"
                                    Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                    Margin="5,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Dosis-Volumen-Histogramm"
                                       Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
                            <TextBlock Text="Strukturen auswählen und die Kurven in voller verfügbarer Breite prüfen."
                                       Style="{StaticResource WorkspaceMutedText}"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid x:Name="DvhContentGrid"
                          Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition x:Name="DvhStructureColumn" Width="230" MinWidth="190" MaxWidth="300"/>
                            </Grid.ColumnDefinitions>
                        <Border x:Name="DvhStructurePanel"
                                Grid.Column="2"
                                Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="0,0,9,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Strukturen"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ClinicalBlueprintCobaltDark}"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="DvhFilterTextBox"
                                         Grid.Row="1"
                                         Text="{Binding DvhFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Strukturname oder Rolle filtern"
                                         Margin="0,0,0,8"
                                         Padding="7,5"/>
                                <StackPanel Grid.Row="2"
                                            Margin="0,0,0,8">
                                    <ToggleButton x:Name="DvhSelectedOnlyToggle"
                                                  Content="Nur ausgewählte"
                                                  IsChecked="{Binding ShowSelectedDvhOnly, Mode=TwoWay}"
                                                  ToolTip="Aus: alle gefilterten Strukturen"
                                                  HorizontalAlignment="Stretch"
                                                  Padding="7,4"
                                                  Margin="0,0,0,5"/>
                                    <UniformGrid Columns="2">
                                        <Button x:Name="DvhSelectAllButton"
                                                Content="Alle"
                                                Command="{Binding SelectAllDvhCommand}"
                                                Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                                Padding="6,4"
                                                Margin="0,0,3,0"/>
                                        <Button x:Name="DvhClearSelectionButton"
                                                Content="Keine"
                                                Command="{Binding ClearDvhSelectionCommand}"
                                                Style="{StaticResource ClinicalBlueprintSecondaryButton}"
                                                Padding="6,4"
                                                Margin="3,0,0,0"/>
                                    </UniformGrid>
                                </StackPanel>
                                <ListBox x:Name="DvhSeriesList"
                                         Grid.Row="3"
                                         ItemsSource="{Binding FilteredDvhSeries}"
                                         ItemTemplate="{StaticResource WorkspaceDvhLegend}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch">
                                </ListBox>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1"
                                      Width="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="{StaticResource ClinicalBlueprintBorder}"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      Focusable="True"/>
                        <Border Grid.Column="0"
                                Padding="10"
                                Style="{StaticResource ClinicalBlueprintCard}"
                                Margin="9,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <oxy:PlotView x:Name="DvhDetailPlot"
                                          Model="{Binding DetailPlotModel}"
                                          Controller="{Binding DetailPlotController}"
                                          DefaultTrackerTemplate="{StaticResource WorkspaceDvhTrackerTemplate}"
                                          MinWidth="0"
                                          MinHeight="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="PlanImagesTab" Header="Schnittbilder" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <views:PlanImagesView DataContext="{Binding PlanImages}"/>
            </TabItem>
            <TabItem x:Name="PlanParametersTab" Header="Planparameter" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <views:PlanParametersView DataContext="{Binding Analysis}"/>
            </TabItem>
            <TabItem x:Name="ComparisonTab" Header="Vergleich" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <views:PlanComparisonView/>
            </TabItem>
            <TabItem x:Name="BevTab" Header="BEV / MLC" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <views:BeamEyeView DataContext="{Binding Analysis}"/>
            </TabItem>
            <TabItem x:Name="WarningsTab" Header="Warnings" Style="{StaticResource ClinicalBlueprintNavigationTab}">
                <Grid Margin="24,22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Native Eclipse-Prüfmeldungen" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource ClinicalBlueprintCobaltDark}"/>
                    <TextBlock Grid.Row="1" Text="{Binding WarningSourceText}" TextWrapping="Wrap" Margin="0,8,0,20"
                               Foreground="{StaticResource ClinicalBlueprintText}"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding WarningRows}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding ObservedValue}" Width="1.2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="1*"/>
                            <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="5*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
