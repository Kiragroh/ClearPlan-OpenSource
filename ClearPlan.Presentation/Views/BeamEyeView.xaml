<UserControl x:Class="ClearPlan.Presentation.Views.BeamEyeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" Foreground="{DynamicResource ClinicalBlueprintText}" Loaded="OnLoaded">
 <!-- THESIS: Anatomy and the actual MLC opening share one measured coordinate frame.
 OWN-WORLD: The established Clinical Blueprint rail frames a dark image viewport and quiet field-information panel.
 STORY: Choose a field and CP; inspect DRR, distinct MLC layers and named jaws; move deliberately through the field.
 FIRST VIEWPORT: Title and field selection above a large stretching BEV; CP navigation and explicit DRR action stay adjacent.
 FORM: User-specified scoped native extension; no new visual world or concept seed.
 FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/ClinicalBlueprint.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <CheckBox x:Name="BevDetailZoom" Content="Details vergrößern" VerticalAlignment="Center" Margin="0,0,18,0" ToolTip="Standard: gesamte Feldöffnung sichtbar. Detailansicht: vergrößert und scrollbar."/>
    <TextBlock Text="Feld" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox ItemsSource="{Binding Beams}" SelectedItem="{Binding SelectedBeam}" DisplayMemberPath="BeamId" MinWidth="150" MaxWidth="260" Padding="8,5" AutomationProperties.Name="Feld für Beam’s-eye View"/>
   </StackPanel>
   <TextBlock Text="BEV &amp; MLC" Style="{StaticResource ClinicalBlueprintSectionTitle}"/>
  </DockPanel>
  <TextBlock Grid.Row="1" Text="Feldöffnung und Anatomie · Maßstab in der Isozentrumsebene · Keine Kollisionsprüfung" Foreground="{StaticResource ClinicalBlueprintTextMuted}" Margin="0,0,0,14" TextWrapping="Wrap"/>
  <Border Grid.Row="2" Background="#101923" BorderBrush="{StaticResource ClinicalBlueprintBorder}" BorderThickness="1" ClipToBounds="True">
   <ScrollViewer x:Name="BevViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                 AutomationProperties.Name="BEV-Bildbereich; gesamte Feldöffnung oder vergrößerte Detailansicht">
    <Grid Height="{Binding ActualHeight, ElementName=BevViewport}">
     <Grid.Style><Style TargetType="Grid"><Setter Property="MinHeight" Value="320"/><Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked, ElementName=BevDetailZoom}" Value="True"><Setter Property="MinHeight" Value="640"/></DataTrigger>
     </Style.Triggers></Style></Grid.Style>
     <Image x:Name="BevImage" Source="{Binding BevImageSource}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="BEV mit verfügbarer CT-Projektion und Feldgeometrie, Feldparametern und Orientierungsschema"/>
    </Grid>
   </ScrollViewer>
  </Border>
  <Grid Grid.Row="3" Margin="0,14,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="Zurück" Command="{Binding PreviousControlPointCommand}" Style="{StaticResource ClinicalBlueprintSecondaryButton}" Margin="0,0,6,0" AutomationProperties.Name="Vorheriger Kontrollpunkt"/>
    <Button Content="Weiter" Command="{Binding NextControlPointCommand}" Style="{StaticResource ClinicalBlueprintSecondaryButton}" AutomationProperties.Name="Nächster Kontrollpunkt"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
    <TextBlock Text="{Binding ControlPointText}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
    <Slider Minimum="0" Maximum="{Binding MaximumControlPointPosition}" Value="{Binding ControlPointPosition, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" AutomationProperties.Name="Kontrollpunkt auswählen"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="BevStatusIndicator" Width="32" Height="32" Padding="0" Margin="0,0,8,0"
            Style="{StaticResource ClinicalBlueprintSecondaryButton}" Click="OnStatusDetailsClick"
            AutomationProperties.Name="{Binding BevStatusSummary}" AutomationProperties.HelpText="{Binding BevStatusText}"
            ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
     <Grid Width="16" Height="16" IsHitTestVisible="False">
      <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="1"/>
      <Path Data="M8,7 L8,12 M8,4.5 L8,4.7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     </Grid>
     <Button.ToolTip>
      <ToolTip x:Name="BevStatusToolTip" Placement="Top" MaxWidth="420" StaysOpen="False"
               Background="{StaticResource ClinicalBlueprintSurface}" Foreground="{StaticResource ClinicalBlueprintText}"
               BorderBrush="{StaticResource ClinicalBlueprintBorder}" BorderThickness="1" Padding="12"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
       <StackPanel>
        <TextBlock Text="{Binding BevStatusSummary}" Foreground="{StaticResource ClinicalBlueprintText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding BevStatusText}" Foreground="{StaticResource ClinicalBlueprintText}" TextWrapping="Wrap"/>
       </StackPanel>
      </ToolTip>
     </Button.ToolTip>
    </Button>
    <Button Content="DRR laden" Command="{Binding GenerateDrrCommand}" Style="{StaticResource ClinicalBlueprintPrimaryButton}"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="CT-Projektion für genau diesen Kontrollpunkt laden bzw. berechnen. Im klinischen Modus ausschließlich aus der aktuellen ESAPI-Planungs-CT. Details zur Verfügbarkeit am Infosymbol."/>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
