<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ClinicalBlueprintCanvas" Color="#F3F5F7"/>
    <SolidColorBrush x:Key="ClinicalBlueprintSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ClinicalBlueprintSurfaceMuted" Color="#EEF1F4"/>
    <SolidColorBrush x:Key="ClinicalBlueprintCobalt" Color="#0F766E"/>
    <SolidColorBrush x:Key="ClinicalBlueprintCobaltDark" Color="#16324A"/>
    <SolidColorBrush x:Key="ClinicalBlueprintNavigation" Color="#17212B"/>
    <SolidColorBrush x:Key="ClinicalBlueprintNavigationSelected" Color="#313A46"/>
    <SolidColorBrush x:Key="ClinicalBlueprintAmber" Color="#D99B36"/>
    <SolidColorBrush x:Key="ClinicalBlueprintTeal" Color="#0F766E"/>
    <SolidColorBrush x:Key="ClinicalBlueprintGreen" Color="#15803D"/>
    <SolidColorBrush x:Key="ClinicalBlueprintRed" Color="#B42318"/>
    <SolidColorBrush x:Key="ClinicalBlueprintText" Color="#202B38"/>
    <SolidColorBrush x:Key="ClinicalBlueprintTextMuted" Color="#667585"/>
    <SolidColorBrush x:Key="ClinicalBlueprintBorder" Color="#D6DDE4"/>
    <SolidColorBrush x:Key="ClinicalBlueprintPassSurface" Color="#EAF6EE"/>
    <SolidColorBrush x:Key="ClinicalBlueprintVariationSurface" Color="#FFF5DD"/>
    <SolidColorBrush x:Key="ClinicalBlueprintFailSurface" Color="#FDEDEC"/>
    <SolidColorBrush x:Key="ClinicalBlueprintInfoSurface" Color="#EAF2F7"/>

    <DropShadowEffect x:Key="ClinicalBlueprintCardShadow"
                      BlurRadius="12"
                      ShadowDepth="2"
                      Opacity="0.09"/>

    <Style x:Key="ClinicalBlueprintPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ClinicalBlueprintTeal}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#115E59"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="#134E4A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClinicalBlueprintSecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource ClinicalBlueprintPrimaryButton}">
        <Setter Property="Background" Value="#E5ECEC"/>
        <Setter Property="Foreground" Value="#175D59"/>
    </Style>

    <Style x:Key="ClinicalBlueprintCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ClinicalBlueprintSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource ClinicalBlueprintCardShadow}"/>
    </Style>

    <Style x:Key="ClinicalBlueprintSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintCobaltDark}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ClinicalBlueprintNavigationTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="#D7E0E8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Width" Value="184"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="6,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="NavBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            CornerRadius="3"
                            Padding="12,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavBorder"
                                    Property="Background"
                                    Value="{StaticResource ClinicalBlueprintNavigationSelected}"/>
                            <Setter TargetName="NavBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource ClinicalBlueprintAmber}"/>
                            <Setter Property="Foreground" Value="#FFF8E8"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="NavBorder"
                                    Property="Background"
                                    Value="#27323E"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource ClinicalBlueprintAmber}"/>
                            <Setter TargetName="NavBorder"
                                    Property="BorderThickness"
                                    Value="3,0,0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClinicalBlueprintStatusBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ClinicalBlueprintInfoSurface}"/>
        <Setter Property="BorderBrush" Value="#B8C7D2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusCode}" Value="pass">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintPassSurface}"/>
                <Setter Property="BorderBrush" Value="#78B88B"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="variation">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintVariationSurface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintAmber}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="fail">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintFailSurface}"/>
                <Setter Property="BorderBrush" Value="#D47C75"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="available">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintPassSurface}"/>
                <Setter Property="BorderBrush" Value="#78B88B"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="fallback">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintVariationSurface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintAmber}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="unavailable">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintFailSurface}"/>
                <Setter Property="BorderBrush" Value="#D47C75"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ClinicalBlueprintModeBadge" TargetType="Border">
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#E7F4F2"/>
        <Setter Property="BorderBrush" Value="#79B9B3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSynthetic}" Value="True">
                <Setter Property="Background" Value="#FFF2D5"/>
                <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintAmber}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E5E9EE"/>
        <Setter Property="VerticalGridLinesBrush" Value="#E5E9EE"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFB"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#E9EEF2"/>
        <Setter Property="Foreground" Value="#344454"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="7,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FFF3D6"/>
                <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintText}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintAmber}"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
</ResourceDictionary>
