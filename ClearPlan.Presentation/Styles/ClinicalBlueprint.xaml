<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UKL palette (2026-11-20). Source: colour scheme of the official UKL PowerPoint
         template UKL_16zu9_Vorlage.potx / UKL_TPC.potx: accent1 #008AC9 (UKL blue),
         accent2 #243357 (navy), dk2 #646464, lt2 #C8C8C8. Accent purple #7B4C9D (UKL-Lila)
         from the UKL presentation starter (ukl-html-presentations, tokens of the verified Kiel
         deck); it replaced the template's accent3 #A30050 on 2026-11-20 because that reads as red
         (Max). Red stays reserved for findings and errors.
         #0072A6 is accent1 darkened so that white text reaches 5.3:1 contrast.
         Resource keys keep their historical names so bindings and tests stay stable;
         green, amber and red remain the semantic result colours. -->
    <Color x:Key="UklBlueColor">#008AC9</Color>
    <Color x:Key="UklBlueDarkColor">#0072A6</Color>
    <Color x:Key="UklNavyColor">#243357</Color>
    <Color x:Key="UklPurpleColor">#7B4C9D</Color>

    <SolidColorBrush x:Key="UklBlue" Color="{StaticResource UklBlueColor}"/>
    <SolidColorBrush x:Key="UklBlueDark" Color="{StaticResource UklBlueDarkColor}"/>
    <SolidColorBrush x:Key="UklNavy" Color="{StaticResource UklNavyColor}"/>
    <SolidColorBrush x:Key="UklPurple" Color="{StaticResource UklPurpleColor}"/>
    <SolidColorBrush x:Key="UklBlueTint" Color="#E6F3FA"/>
    <SolidColorBrush x:Key="UklBlueTintBorder" Color="#B9D9EA"/>

    <SolidColorBrush x:Key="ClinicalBlueprintCanvas" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="ClinicalBlueprintSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ClinicalBlueprintSurfaceMuted" Color="#EEF1F4"/>
    <SolidColorBrush x:Key="ClinicalBlueprintCobalt" Color="#0072A6"/>
    <SolidColorBrush x:Key="ClinicalBlueprintCobaltDark" Color="#243357"/>
    <SolidColorBrush x:Key="ClinicalBlueprintNavigation" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ClinicalBlueprintNavigationSelected" Color="#E6F3FA"/>
    <SolidColorBrush x:Key="ClinicalBlueprintAmber" Color="#D99B36"/>
    <SolidColorBrush x:Key="ClinicalBlueprintWarningText" Color="#9A6508"/>
    <SolidColorBrush x:Key="ClinicalBlueprintTeal" Color="#0072A6"/>
    <SolidColorBrush x:Key="ClinicalBlueprintGreen" Color="#15803D"/>
    <SolidColorBrush x:Key="ClinicalBlueprintRed" Color="#B42318"/>
    <SolidColorBrush x:Key="ClinicalBlueprintText" Color="#1F2937"/>
    <SolidColorBrush x:Key="ClinicalBlueprintTextMuted" Color="#646464"/>
    <SolidColorBrush x:Key="ClinicalBlueprintBorder" Color="#DDE2E7"/>
    <SolidColorBrush x:Key="ClinicalBlueprintPassSurface" Color="#EAF6EE"/>
    <SolidColorBrush x:Key="ClinicalBlueprintVariationSurface" Color="#FFF5DD"/>
    <SolidColorBrush x:Key="ClinicalBlueprintFailSurface" Color="#FDEDEC"/>
    <SolidColorBrush x:Key="ClinicalBlueprintInfoSurface" Color="#E6F3FA"/>

    <DropShadowEffect x:Key="ClinicalBlueprintCardShadow"
                      BlurRadius="12"
                      ShadowDepth="2"
                      Opacity="0.09"/>

    <!-- One button template for every action; disabled state stays readable. -->
    <Style x:Key="ClinicalBlueprintPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource UklBlueDark}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource UklBlueDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#005F8A"/>
                            <Setter Property="BorderBrush" Value="#005F8A"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource UklNavy}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#F1F3F5"/>
                            <Setter Property="BorderBrush" Value="#D5DBE1"/>
                            <Setter Property="Foreground" Value="#7A8491"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClinicalBlueprintSecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource ClinicalBlueprintPrimaryButton}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource UklBlueDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UklBlueTintBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource UklBlueTint}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource UklBlueDark}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource UklNavy}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#F1F3F5"/>
                            <Setter Property="BorderBrush" Value="#D5DBE1"/>
                            <Setter Property="Foreground" Value="#7A8491"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClinicalBlueprintCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ClinicalBlueprintSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Type scale: 20 page title, 15 section, 13 body/table, 12 secondary. -->
    <Style x:Key="ClinicalBlueprintSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintCobaltDark}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ClinicalBlueprintSubsectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintCobaltDark}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ClinicalBlueprintPageSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintTextMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Navigation: white rail, UKL purple marker for the selected destination. -->
    <Style x:Key="ClinicalBlueprintNavigationTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Width" Value="196"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="NavBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            Padding="29,0,12,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavBorder"
                                    Property="Background"
                                    Value="{StaticResource ClinicalBlueprintNavigationSelected}"/>
                            <Setter TargetName="NavBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource UklPurple}"/>
                            <Setter Property="Foreground" Value="{StaticResource UklNavy}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="NavBorder"
                                    Property="Background"
                                    Value="#F0F3F6"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource UklBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Non-selectable group label inside the navigation rail. -->
    <Style x:Key="ClinicalBlueprintNavigationGroup" TargetType="TabItem">
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="196"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Margin="0,12,0,2"
                            Height="28"
                            Background="{StaticResource ClinicalBlueprintCanvas}"
                            BorderBrush="{StaticResource ClinicalBlueprintBorder}"
                            BorderThickness="0,1,0,1"
                            Padding="20,0,12,0">
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          TextElement.FontSize="11"
                                          TextElement.FontWeight="Bold"
                                          TextElement.Foreground="{StaticResource UklNavy}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Result chip: tinted surface, coloured text, no border; fits a 36 px row. -->
    <Style x:Key="ClinicalBlueprintStatusBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ClinicalBlueprintInfoSurface}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusCode}" Value="pass">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintPassSurface}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="variation">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintVariationSurface}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="fail">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintFailSurface}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="available">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintPassSurface}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="fallback">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintVariationSurface}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="unavailable">
                <Setter Property="Background" Value="{StaticResource ClinicalBlueprintFailSurface}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ClinicalBlueprintModeBadge" TargetType="Border">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource UklBlueTint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UklBlueTintBorder}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSynthetic}" Value="True">
                <Setter Property="Background" Value="#FFF2D5"/>
                <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintAmber}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Tables: 13 px text, 36 px rows, every cell vertically centred. -->
    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintText}"/>
        <Setter Property="MinRowHeight" Value="36"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E8EBEF"/>
        <Setter Property="VerticalGridLinesBrush" Value="#E8EBEF"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="White"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F4F6F8"/>
        <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintTextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClinicalBlueprintBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="ClinicalBlueprintNumericHeader"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="ClinicalBlueprintNumericCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F7F9FB"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource UklBlueTint}"/>
                <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource UklBlueTint}"/>
                <Setter Property="Foreground" Value="{StaticResource ClinicalBlueprintText}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource UklBlue}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
