<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget><Platforms>x64;AnyCPU</Platforms>
    <OutputPath>..\artifacts\dicom-tests\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClearPlan.Dicom\ClearPlan.Dicom.csproj" />
    <Reference Include="Newtonsoft.Json"><HintPath>..\ClearPlan-DLLs\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
